# Entornos virtuales
venv/
env/
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.sqlite3

# Node / Frontend
node_modules/
dist/
build/
.npm/

# Ajustes de Docker propios de cada máquina (ej. publicar Postgres en otro
# puerto porque el 5432 ya lo ocupa una instalación nativa).
docker/docker-compose.override.yml

# IDEs y OS
.vscode/
.idea/
.DS_Store
*.log
media/

# Reportes con datos reales de clientes: se generan localmente, no se suben.
# `*.csv` ya cubre entregas_pesos.csv y cualquier otro que salga.
*.csv

# Excel con datos de clientes. La regla apuntaba a backend/delivery/data/, que
# ya no existe: el Excel semilla se eliminó y SAP es la única fuente. Se deja a
# nivel de patrón para que ningún reporte nuevo se suba por descuido.
*.xlsx
