# Copia este archivo a .env y llena los valores reales en cada máquina.
# .env NUNCA se sube a git (ver .gitignore) — hay que configurarlo a mano
# en cada computadora donde corra el backend.

# Django. La llave firma sesiones y tokens: si se filtra, se pueden falsificar.
# La que estaba escrita en settings.py quedó publicada en GitHub y NO se debe
# reutilizar. Generar una propia en cada máquina con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# En producción: DJANGO_DEBUG=False y listar los dominios permitidos.
#
# OJO al copiar este archivo tal cual en el servidor: con DEBUG=True cualquier
# error muestra el código fuente Y la contraseña de SAP en la página de error.
DJANGO_DEBUG=True
# Con DEBUG=False esta lista NO puede quedar vacía o todo responde 400.
# Ej: DJANGO_ALLOWED_HOSTS=logistica.laben.mx,192.168.1.50
DJANGO_ALLOWED_HOSTS=
# Orígenes que pueden llamar a la API desde el navegador. Con DEBUG=True se
# permite todo; con DEBUG=False, lo que no esté aquí lo bloquea el navegador.
# Es la variable que cierra CORS en producción y no estaba documentada.
# Ej: CORS_ORIGINS=https://logistica.laben.mx
CORS_ORIGINS=

# Base de datos Postgres. Es la ÚNICA base: si no responde, el backend truena
# a propósito en vez de trabajar contra datos viejos.
DB_NAME=laben_routing
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
# 5432 normalmente. Si la máquina ya tiene un Postgres nativo ocupando ese
# puerto, poner DB_PUERTO_HOST=5433 en docker/.env y el mismo 5433 aquí.
# Ojo en Windows: usar 127.0.0.1 y no "localhost" en DB_HOST, porque localhost
# resuelve primero a IPv6 y ahí puede estar escuchando el Postgres nativo.
DB_PORT=5432

# OSRM propio (Docker). Si se deja vacío, usa el servidor público de demo.
OSRM_BASE=http://localhost:5001

# Samsara (GPS/telemetría de la flotilla). Generar en:
# Samsara > Configuración > Desarrollador > Tokens de API > Agregar un token de API
SAMSARA_API_TOKEN=

# Conexión a SAP B1 (SQL Server). Si se deja vacío, sync_from_sap reporta
# "SAP no configurado" en vez de inventar pedidos.
SAP_DB_HOST=
SAP_DB_NAME=
SAP_DB_USER=
SAP_DB_PASSWORD=
SAP_DB_PORT=1433
# Driver ODBC. El default es "ODBC Driver 17 for SQL Server".
#   · SQL Server 2012 en Windows no soporta el 17: usar
#     SAP_ODBC_DRIVER=SQL Server Native Client 11.0
#   · En macOS (Apple Silicon) el Native Client NO EXISTE. El único driver es el
#     18, que además exige TLS por default y falla contra un certificado
#     autofirmado, así que hay que agregarle ;Encrypt=no;TrustServerCertificate=yes
#     SAP_ODBC_DRIVER=ODBC Driver 18 for SQL Server
#     Se instala con: brew install msodbcsql18 mssql-tools18 unixodbc
#     (tap microsoft/mssql-release). Probar ANTES con `sqlcmd`.
SAP_ODBC_DRIVER=
# Segundos que se espera una CONSULTA a SAP (el timeout de conexión es aparte y
# son 5). Sin esto una consulta se podía colgar indefinidamente y, como el panel
# sincroniza cada 45 s, se acumulaban peticiones muertas.
SAP_TIMEOUT_CONSULTA=45

# Nombres de los UDF (campos definidos por usuario) en SAP B1 — solo si
# difieren de los defaults que usa integrations/sap.py.
# SAP_UDF_LATITUDE=U_Latitud
# SAP_UDF_LONGITUDE=U_Longitud
# SAP_UDF_HORA_INI1=U_IniRecibo1
# SAP_UDF_HORA_FIN1=U_FinRecibo1
# SAP_UDF_HORA_INI2=U_IniRecibo2
# SAP_UDF_HORA_FIN2=U_FinRecibo2
# Días en que cada cliente recibe. El optimizador ya los respeta; la base
# productiva todavía no los tiene, y sin el dato se asume que sí recibe.
# SAP_UDF_ENT_LUN=U_EntLun   (… MAR, MIE, JUE, VIE, SAB)
# Contacto del Ship-To. Van vacíos a propósito: si se piden y la columna no
# existe en CRD1, la consulta entera truena con "Invalid column name".
# SAP_UDF_CONTACTO=
# SAP_UDF_TELEFONO=
# SAP_UDF_REFERENCIAS=

# ── Optimizador ──────────────────────────────────────────────────────────────
# Segundos que el solver puede pensar. Bajarlo da rutas PEORES, no rutas
# equivocadas: sirve para que la suite de pruebas no tarde un minuto.
OPTIMIZER_SEGUNDOS=20

# ── Solo para correr las pruebas ─────────────────────────────────────────────
# DJANGO_TEST_DB=sqlite  ->  la suite corre sin Postgres:
#   DJANGO_TEST_DB=sqlite python manage.py test delivery
